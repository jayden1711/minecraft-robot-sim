{
  "schemaVersion": 1,
  "id": "mcrobot",
  "version": "${version}",
  "name": "Minecraft Robot Sim bridge",
  "description": "Server-side bridge from a Fabric server to the Python/MuJoCo trainer. Simulation only: physics is MuJoCo.",
  "authors": ["minecraft-robot-sim contributors"],
  "license": "Apache-2.0",
  "environment": "server",
  "entrypoints": {
    "main": ["dev.mcrobot.McRobotMod"]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "${minecraft_dep}",
    "java": ">=${java_dep}",
    "fabric-api": "*"
  }
}
